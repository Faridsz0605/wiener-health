# wiener environment. Copy to .env and fill. Never commit .env.
# The whole file (minus AWS_PROFILE) is pushed to SSM /wiener/env by scripts/deploy_box.sh.

# ---------- AWS (local) ----------
AWS_PROFILE=wiener
AWS_REGION=us-east-1
ALERT_EMAIL=you@example.com

# ---------- Open Wearables ----------
OW_VERSION=0.10.0
# Random, 32+ chars. Generate: openssl rand -hex 32
SECRET_KEY=
DB_PASSWORD=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ENVIRONMENT=production
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
SENTRY_ENABLED=false
OUTGOING_WEBHOOKS_ENABLED=false
TELEMETRY_ENABLED=false
# Developer portal -> Settings -> Credentials -> API Keys (after first deploy)
OW_API_KEY=

# Google Health API (Google Cloud console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Numeric project NUMBER, not the ID
GOOGLE_PROJECT_ID=
GOOGLE_USE_RECONCILE=true
# Use /oauth/google_health/callback (matches the redirect URI registered in Google Cloud)
GOOGLE_LEGACY_OAUTH_PATH=false

# ---------- Extraction ----------
EXTRACTION_WINDOW_DAYS=3

# ---------- Analysis Store (M3) ----------
ANALYSIS_DB_PASSWORD=
# Read-only role used by the MCP agent
ANALYSIS_READER_PASSWORD=

# ---------- Databricks (M2) ----------
DATABRICKS_HOST=
DATABRICKS_TOKEN=
