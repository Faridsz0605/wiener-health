[Unit]
Description=wiener extraction: Open Wearables -> Raw Archive
After=docker.service
OnFailure=wiener-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wiener/app
EnvironmentFile=/opt/wiener/.env
TimeoutStartSec=900
# Open Wearables API can take minutes to come up after a restart
ExecStartPre=/bin/sh -c "until curl -sf -o /dev/null http://127.0.0.1:8000/docs; do sleep 5; done"
ExecStart=/usr/local/bin/uv run --frozen --no-dev python -m extraction.extract
